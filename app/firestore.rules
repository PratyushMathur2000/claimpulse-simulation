rules_version = '2';

// ClaimPulse demo database.
//
// This project holds DEMO CLAIMS ONLY — synthetic policyholders, synthetic
// damage, synthetic payouts. No real policy, customer or claim data ever
// reaches it. It exists so a judge can file a claim on their own phone and
// watch it land on the projected Ops Console.
//
// Access is deliberately open within one path so no sign-in step stands
// between a judge and the demo. Everything outside that path is closed,
// documents are size-capped, and the project is disposable.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{room}/claims/{claim} {
      allow read: if true;
      allow create: if request.resource.data.createdAt is number
                    && request.resource.size() < 60;

      // An update may move a claim along; it may not rewrite when the claim
      // was filed, and it may not grow the document past the cap. That stops
      // a passer-by corrupting a claim into something the UI cannot render.
      allow update: if request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.size() < 60;

      // Delete stays open because the presenter's "Clear the queue" needs it.
      // It is the one genuinely destructive path, so the UI confirms first
      // and names the room and the count. Without sign-in there is no way to
      // tell the presenter from a visitor; the mitigation is the confirm, a
      // disposable project, and synthetic data.
      allow delete: if true;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
