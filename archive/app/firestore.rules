rules_version = '2';

// ClaimPulse demo database.
//
// This project holds DEMO CLAIMS ONLY — synthetic policyholders, synthetic
// damage, synthetic payouts. No real policy, customer or claim data ever
// reaches it. It exists so a judge can file a claim on their own phone and
// watch it land on the projected Ops Console.
//
// Access is deliberately open within one path so no sign-in step stands
// between a judge and the demo. Everything outside that path is closed,
// documents are size-capped, and the project is disposable.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{room}/claims/{claim} {
      allow read: if true;
      allow create: if request.resource.data.createdAt is number
                    && request.resource.size() < 60;

      // Deliberately permissive, and staying that way.
      //
      // A tighter update rule was tried - createdAt must not change - and it
      // is the wrong trade here. serialise() falls back to Date.now() whenever
      // createdAt is not a number, so a single round-trip that loses the field
      // would write a fresh timestamp, the rule would reject it, the catch
      // would fire goLocal(), and the projector would silently stop sharing
      // with the judges' phones in the middle of a demo. That failure costs
      // more than the corruption it prevents.
      //
      // What actually protects this: the data is synthetic, the project is
      // disposable, and the one destructive path - "Clear the queue" - asks
      // for confirmation and names the room and the count before it runs.
      allow update, delete: if true;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
